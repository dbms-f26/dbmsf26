{
  "name": "DB Course Environment",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "forwardPorts": [5432, 5000],
  "portsAttributes": {
    "5000": { "label": "Flask App" },
    "5432": { "label": "Postgres" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-ossdata.vscode-pgsql"]
    }
  }
}
